rules_version = '2';
// 성경&찬양 앱 Firestore 보안 규칙 (Firebase 콘솔에 게시된 내용과 동일, 2026.06.28 게시)
// 앱은 Google 로그인 후 users/{uid} 문서 하나에 즐겨찾기·콘티·태그·필기·형광펜·읽기표 진도를 백업한다.
// 로그인한 본인만 자기 문서를 읽고 쓸 수 있고, 그 밖의 경로는 모두 거부된다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
